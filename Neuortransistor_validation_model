# SECTION 5: SINGLE COLUMN LIF VALIDATION (CORRECTED!)
# ══════════════════════════════════════════════════════════════════════════════
def validate_single_column(params_bot):
    """
    Validate single column LIF behavior with SPICE and Math comparison.
    
    CORRECTED: Uses trapezoidal pulse to match SPICE rise/fall times.
    """
    print("\n" + "="*60)
    print("SINGLE COLUMN LIF VALIDATION (CORRECTED)")
    print("="*60)
    
    x = 0.2
    V_pulse = P.V_pulse
    Is, Vth, kappa, lam = params_bot
    R_out = 10  # 10Ω
    
    # Pulse parameters (matching SPICE)
    T_delay = 10e-6
    T_rise = P.T_rise      # 1µs - CRITICAL!
    T_on = 80e-6
    T_fall = P.T_fall      # 1µs - CRITICAL!
    
    print(f"  R_out = {R_out} Ω")
    print(f"  VDD = {P.VDD} V")
    print(f"  T_rise = {T_rise*1e6:.1f} µs (matching SPICE)")
    print(f"  T_fall = {T_fall*1e6:.1f} µs (matching SPICE)")
    
    memcap_subckt = f"""
.SUBCKT MEMCAP TE BE SV
.param Ar={P.Ar} As={P.As} Br={P.Br} Bs={P.Bs} Rp={P.Rp} Rs={P.Rs} Cp={P.Cp}
.func Gm(x,Vm) {{Ar*x*exp(Br*sgn(Vm)*sqrt(abs(Vm)/x))+As*x*exp(-Bs*sgn(Vm)*sqrt(abs(Vm)))}}
Bmem IE BE i=V(IE,BE)*Gm(V(SV,0),V(IE,BE))
Rms TE IE {{Rs}}
Rmp IE BE {{Rp}}
Cmp TE BE {{Cp}}
Cx SV 0 1
.IC V(SV)={x}
.ENDS
"""
    
    ckt = Circuit('SingleColumnLIF')
    ckt.raw_spice += memcap_subckt
    
    # SPICE pulse with 1µs rise/fall times
    ckt.raw_spice += f"Vinput vin 0 PULSE(0 {V_pulse} {T_delay} {T_rise} {T_fall} {T_on} 200u)\n"
    ckt.raw_spice += f"Vdd vdd 0 DC 1.0\n"
    ckt.raw_spice += f"Xmem vin col sv MEMCAP\n"
    ckt.raw_spice += f"Cgb col 0 {P.C_gb}\n"
    
    if P.bot_Level == 14:
        ckt.raw_spice += f".model NMOS_BOT nmos LEVEL={P.bot_Level} L={P.bot_L} W={P.bot_W} VTH0={P.bot_Vth} TOXE={P.bot_Tox}\n"
    else:
        ckt.raw_spice += f".model NMOS_BOT nmos LEVEL={P.bot_Level} L={P.bot_L} W={P.bot_W} Vto={P.bot_Vth} Tox={P.bot_Tox}\n"
    
    ckt.raw_spice += f"Rout vdd drain {R_out}\n"
    ckt.raw_spice += f"M1 drain col 0 0 NMOS_BOT\n"
    ckt.raw_spice += ".save all\n"
    
    # Run simulation
    simulator = ckt.simulator()
    res = simulator.transient(step_time=0.5e-6, end_time=150e-6)
    
    t_spice = np.array(res.time)
    
    # Access nodes
    try:
        V_col_spice = np.array(res['col'])
    except:
        V_col_spice = np.zeros_like(t_spice)
        for key in res.nodes.keys():
            if 'col' in key.lower():
                V_col_spice = np.array(res[key])
                break
    
    try:
        V_in_spice = np.array(res['vin'])
    except:
        V_in_spice = np.zeros_like(t_spice)
        for key in res.nodes.keys():
            if 'vin' in key.lower():
                V_in_spice = np.array(res[key])
                break
    
    try:
        V_drain_spice = np.array(res['drain'])
    except:
        V_drain_spice = np.ones_like(t_spice) * 1.0
        for key in res.nodes.keys():
            if 'drain' in key.lower():
                V_drain_spice = np.array(res[key])
                break
    
    I_out_spice = (P.VDD - V_drain_spice) / R_out
    
    print(f"  SPICE: max V_in = {np.max(V_in_spice):.3f} V")
    print(f"  SPICE: max V_col = {np.max(V_col_spice):.3f} V")
    print(f"  SPICE: max I_out = {np.max(I_out_spice)*1e3:.2f} mA")
    
    # ----- Math Model (CORRECTED!) -----
    print("\nRunning Math model (with trapezoidal pulse)...")
    
    t_math = np.linspace(0, 150e-6, 1000)
    dt = t_math[1] - t_math[0]
    V_col_math = np.zeros_like(t_math)
    V_in_math = np.zeros_like(t_math)
    I_out_math = np.zeros_like(t_math)
    
    Vt_prev = 0.0
    V_in_prev = 0.0
    
    for i in range(1, len(t_math)):
        # CORRECTED: Use trapezoidal pulse instead of ideal step!
        V_in = trapezoidal_pulse(t_math[i-1], T_delay, T_rise, T_on, T_fall, V_pulse)
        V_in_math[i] = V_in
        
        Vt = V_in - V_col_math[i-1]
        Vm = solve_memcap_internal(Vt, x)
        I_res = (Vt - Vm) / P.Rs
        
        # CORRECTED: Capacitive current uses actual dV_in/dt from trapezoidal pulse
        dV_in_dt = (V_in - V_in_prev) / dt
        I_cap = P.Cp * dV_in_dt
        
        I_syn = I_res + I_cap
        
        dV_dt = I_syn / P.C_gb_math
        V_col_math[i] = max(0, V_col_math[i-1] + dV_dt * dt)
        
        Vt_prev = Vt
        V_in_prev = V_in
        
        I_out_math[i] = solve_load_line(V_col_math[i], params_bot, R_out, P.VDD)
    
    print(f"  Math: max V_col = {np.max(V_col_math):.3f} V")
    print(f"  Math: max I_out = {np.max(I_out_math)*1e3:.2f} mA")
    
    return {
        't_spice': t_spice,
        'V_col_spice': V_col_spice,
        'I_out_spice': I_out_spice,
        'V_in_spice': V_in_spice,
        't_math': t_math,
        'V_col_math': V_col_math,
        'I_out_math': I_out_math,
        'V_in_math': V_in_math,
        'R_out': R_out
    }


