    Rs = 278                  # Series resistance (Ω)
    Rp = 8e6                  # Parallel leakage resistance (Ω)
    Cp = 10e-12               # Parallel capacitance (10 pF)
    
    # --- Capacitances ---
    C_gb = 90e-12             # Explicit SPICE capacitance
    C_gb_math = 100e-12       # Math model (90pF + 10pF BSIM4 intrinsic)
    C_out = 5e-12             # Mirror output capacitance
    
    # --- Output Stage ---
    R_out = 10                # Output load resistor (10Ω)
    VDD = 1.0                 # Supply voltage
    
